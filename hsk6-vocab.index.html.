const CAT_LABELS = {'TC2-1':'Phần 1','TC2-1b':'Phần 2','TC2-1c':'Phần 3','TC2-1d':'Phần 4','TC2-1e':'Phần 5'};

/* ---------------- storage / progress ---------------- */
let mastered = new Set();
async function loadProgress(){
  try{
    const res = await window.storage.get('hsk6-mastered');
    if(res && res.value){
      mastered = new Set(JSON.parse(res.value));
    }
  }catch(e){ /* no data yet */ }
  refreshProgressUI();
}
async function saveProgress(){
  try{ await window.storage.set('hsk6-mastered', JSON.stringify([...mastered])); }catch(e){}
}
function idOf(item){ return item.h + '|' + item.m; }
function isMastered(item){ return mastered.has(idOf(item)); }
function toggleMastered(item, forceValue){
  const id = idOf(item);
  const next = (forceValue === undefined) ? !mastered.has(id) : forceValue;
  if(next) mastered.add(id); else mastered.delete(id);
  saveProgress();
  refreshProgressUI();
}
function refreshProgressUI(){
  const total = VOCAB.length;
  const done = mastered.size;
  const pct = total ? Math.round(done/total*100) : 0;
  document.getElementById('masteredCount').textContent = done;
  document.getElementById('totalCount').textContent = total;
  document.getElementById('totalHeaderCount').textContent = total;
  document.getElementById('progressPct').textContent = pct + '%';
  document.getElementById('progressRing').style.setProperty('--pct', pct);
  renderWordList();
}

