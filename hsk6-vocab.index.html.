/* ---------------- STUDY LIST ---------------- */
let currentCat = 'all';
let searchTerm = '';
document.getElementById('catFilter').addEventListener('click', e=>{
  const b = e.target.closest('button'); if(!b) return;
  document.querySelectorAll('#catFilter button').forEach(x=>x.classList.remove('active'));
  b.classList.add('active');
  currentCat = b.dataset.cat;
  renderWordList();
});
document.getElementById('searchInput').addEventListener('input', e=>{
  searchTerm = e.target.value.trim().toLowerCase();
  renderWordList();
});

function renderWordList(){
  const list = document.getElementById('wordList');
  let items = VOCAB.filter(it=>it.t==='vocab');
  if(currentCat==='mastered'){
    items = items.filter(it=>isMastered(it));
  } else if(currentCat!=='all'){
    items = items.filter(it=>it.c===currentCat);
  }
  if(searchTerm){
    items = items.filter(it=>
      it.h.toLowerCase().includes(searchTerm) ||
      it.p.toLowerCase().includes(searchTerm) ||
      it.m.toLowerCase().includes(searchTerm)
    );
  }
  if(items.length===0){
    list.innerHTML = '<div class="empty-note">Không tìm thấy từ phù hợp.</div>';
    return;
  }
  list.innerHTML = items.map(it=>{
    const m = isMastered(it);
    return `<div class="word-row ${m?'mastered':''}" data-id="${idOf(it).replace(/"/g,'&quot;')}">
      <div class="hz">${it.h}</div>
      <div class="py">${it.p||'—'}</div>
      <div class="mn">${it.m}</div>
      <span class="cat-tag">${CAT_LABELS[it.c]||it.c}</span>
      <svg class="mstar" viewBox="0 0 24 24" fill="${m?'#4F7A68':'none'}" stroke="#4F7A68" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    </div>`;
  }).join('');
  list.querySelectorAll('.word-row').forEach((row,i)=>{
    row.addEventListener('click', ()=>openModal(items[i]));
  });
}

/* modal */
let modalItem = null;
function openModal(it){
  modalItem = it;
  document.getElementById('modalHz').textContent = it.h;
  document.getElementById('modalPy').textContent = it.p || '';
  document.getElementById('modalMn').textContent = it.m;
  const btn = document.getElementById('modalToggle');
  const m = isMastered(it);
  btn.textContent = m ? '✓ Đã thuộc' : 'Đánh dấu đã thuộc';
  btn.classList.toggle('on', m);
  document.getElementById('modalBg').classList.add('show');
}
document.getElementById('modalClose').addEventListener('click', ()=>document.getElementById('modalBg').classList.remove('show'));
document.getElementById('modalBg').addEventListener('click', e=>{ if(e.target.id==='modalBg') document.getElementById('modalBg').classList.remove('show'); });
document.getElementById('modalToggle').addEventListener('click', ()=>{
  if(!modalItem) return;
  toggleMastered(modalItem);
  const m = isMastered(modalItem);
  const btn = document.getElementById('modalToggle');
  btn.textContent = m ? '✓ Đã thuộc' : 'Đánh dấu đã thuộc';
  btn.classList.toggle('on', m);
});

/* ---------------- FLASHCARDS ---------------- */
let fcDeck = 'all';
let fcQueue = [];
let fcIndex = 0;
let fcFlipped = false;
let fcKnownCount = 0;

document.getElementById('fcDeckSelect').addEventListener('click', e=>{
  const b = e.target.closest('button'); if(!b) return;
  document.querySelectorAll('#fcDeckSelect button').forEach(x=>x.classList.remove('active'));
  b.classList.add('active');
  fcDeck = b.dataset.deck;
  startFlashDeck();
});

function buildDeck(){
  let items = VOCAB.filter(it=>it.t==='vocab');
  if(fcDeck==='unmastered') items = items.filter(it=>!isMastered(it));
  else if(fcDeck!=='all') items = items.filter(it=>it.c===fcDeck);
  // shuffle
  for(let i=items.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [items[i],items[j]] = [items[j],items[i]];
  }
  return items;
}
function startFlashDeck(){
  fcQueue = buildDeck();
  fcIndex = 0; fcKnownCount = 0; fcFlipped = false;
  document.getElementById('fcCount').textContent = fcQueue.length + ' thẻ';
  renderFlashcard();
}
function renderFlashcard(){
  const area = document.getElementById('fcCardArea');
  const bar = document.getElementById('fcBar');
  if(fcQueue.length===0){
    area.innerHTML = '<div class="fc-done"><div class="zh-big">空</div><p>Không có thẻ nào trong bộ này.</p></div>';
    bar.style.width='0%';
    return;
  }
  if(fcIndex >= fcQueue.length){
    bar.style.width='100%';
    area.innerHTML = `<div class="fc-done">
      <div class="zh-big">完</div>
      <p>Bạn đã ôn xong ${fcQueue.length} thẻ · Nhớ ${fcKnownCount} / ${fcQueue.length}</p>
      <button id="fcRestart">Ôn lại bộ này</button>
    </div>`;
    document.getElementById('fcRestart').addEventListener('click', startFlashDeck);
    return;
  }
  bar.style.width = Math.round(fcIndex/fcQueue.length*100)+'%';
  const it = fcQueue[fcIndex];
  fcFlipped = false;
  area.innerHTML = `
    <div class="card-scene">
      <div class="flashcard" id="flashcardEl">
        <div class="face front">
          <div class="hz">${it.h}</div>
          <div class="py">${it.p||''}</div>
          <div class="hint">Chạm để lật thẻ</div>
        </div>
        <div class="face back">
          <svg class="seal-stamp" id="sealStamp" viewBox="0 0 100 100">
            <rect x="6" y="6" width="88" height="88" rx="10" fill="#AF2530" stroke="#F4E9D8" stroke-width="2"/>
            <text x="50" y="60" font-family="Noto Serif SC, serif" font-size="34" font-weight="900" fill="#F4E9D8" text-anchor="middle">记</text>
          </svg>
          <div class="py2">${it.p||''}</div>
          <div class="mn">${it.m}</div>
          <div class="hz-small">${it.h}</div>
        </div>
      </div>
    </div>
    <div class="fc-actions" style="margin-top:22px;">
      <button class="btn-forget" id="btnForget">✕ Chưa nhớ</button>
      <button class="btn-know" id="btnKnow">✓ Đã nhớ</button>
    </div>
  `;
  document.getElementById('flashcardEl').addEventListener('click', ()=>{
    fcFlipped = !fcFlipped;
    document.getElementById('flashcardEl').classList.toggle('flipped', fcFlipped);
  });
  document.getElementById('btnForget').addEventListener('click', (e)=>{
    e.stopPropagation();
    toggleMastered(it, false);
    nextFlashcard();
  });
  document.getElementById('btnKnow').addEventListener('click', (e)=>{
    e.stopPropagation();
    fcKnownCount++;
    toggleMastered(it, true);
    const stamp = document.getElementById('sealStamp');
    if(!fcFlipped){
      fcFlipped = true;
      document.getElementById('flashcardEl').classList.add('flipped');
      setTimeout(()=>{ stamp.classList.add('show'); }, 260);
      setTimeout(nextFlashcard, 900);
    } else {
      stamp.classList.add('show');
      setTimeout(nextFlashcard, 650);
    }
  });
}
function nextFlashcard(){
  fcIndex++;
  renderFlashcard();
}

