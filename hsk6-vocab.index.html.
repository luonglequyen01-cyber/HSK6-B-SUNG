      <div class="py">${it.p||''}</div>
      <div class="meaning">${it.m}</div>
      ${it.u ? `<div class="usage">${it.u}</div>` : ''}
    </div>
  `).join('');
}

/* ---------------- QUIZ ---------------- */
let quizLen = 10;
let quizMode = 'mixed';
let quizItems = [];
let quizIdx = 0;
let quizScore = 0;
let quizAnswered = false;
let quizReview = [];

function renderQuizSetup(){
  const area = document.getElementById('quizArea');
  area.innerHTML = `
    <div class="quiz-setup">
      <h2>练习 · Bài tập ôn kiến thức</h2>
      <p>Chọn số câu và bắt đầu làm bài trắc nghiệm về từ vựng &amp; mẫu câu HSK6.</p>
      <div class="quiz-len" id="quizLenGroup">
        <button data-n="10" class="active">10 câu</button>
        <button data-n="20">20 câu</button>
        <button data-n="30">30 câu</button>
      </div>
      <div class="quiz-mode" id="quizModeGroup">
        <button data-mode="mixed" class="active">Trộn cả hai</button>
        <button data-mode="meaning">Nghĩa của từ</button>
        <button data-mode="fill">Điền vào chỗ trống</button>
      </div>
      <button class="quiz-start-btn" id="quizStartBtn">Bắt đầu làm bài</button>
    </div>
  `;
  document.getElementById('quizLenGroup').addEventListener('click', e=>{
    const b = e.target.closest('button'); if(!b) return;
    document.querySelectorAll('#quizLenGroup button').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    quizLen = parseInt(b.dataset.n,10);
  });
  document.getElementById('quizModeGroup').addEventListener('click', e=>{
    const b = e.target.closest('button'); if(!b) return;
    document.querySelectorAll('#quizModeGroup button').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    quizMode = b.dataset.mode;
  });
  document.getElementById('quizStartBtn').addEventListener('click', startQuiz);
}

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}

function startQuiz(){
  const fillPool = VOCAB.filter(it=>it.s);
  let n = Math.min(quizLen, VOCAB.length);
  quizItems = [];

  if(quizMode === 'fill'){
    const chosen = shuffle(fillPool).slice(0, Math.min(n, fillPool.length));
    quizItems = chosen.map(it=>buildFillQuestion(it));
  } else if(quizMode === 'meaning'){
    const chosen = shuffle(VOCAB).slice(0, n);
    quizItems = chosen.map(it=>buildMeaningQuestion(it));
  } else {
    // mixed: half fill (if available), half meaning
    const fillCount = Math.min(Math.floor(n/2), fillPool.length);
    const meaningCount = n - fillCount;
    const fillChosen = shuffle(fillPool).slice(0, fillCount).map(it=>buildFillQuestion(it));
    const meaningChosen = shuffle(VOCAB).slice(0, meaningCount).map(it=>buildMeaningQuestion(it));
    quizItems = shuffle([...fillChosen, ...meaningChosen]);
  }

  quizIdx = 0; quizScore = 0; quizAnswered = false; quizReview = [];
  renderQuizQuestion();
}

function buildMeaningQuestion(it){
  const mode = Math.random() < 0.5 ? 'h2m' : 'm2h';
  const distractorPool = VOCAB.filter(x=>x.m!==it.m && x.h!==it.h);
  const distractors = shuffle(distractorPool).slice(0,3);
  const options = shuffle([it, ...distractors]);
  return { qtype:'meaning', item: it, mode, options };
}

function buildFillQuestion(it){
  const distractorPool = VOCAB.filter(x=>x.h!==it.h && x.t==='vocab');
  const distractors = shuffle(distractorPool).slice(0,3);
  const options = shuffle([it, ...distractors]);
  return { qtype:'fill', item: it, options };
}

function renderQuizQuestion(){
  const area = document.getElementById('quizArea');
  if(quizIdx >= quizItems.length){
    renderQuizResult();
    return;
  }
  const q = quizItems[quizIdx];
  quizAnswered = false;
  const pct = Math.round(quizIdx/quizItems.length*100);

  let questionHtml = '';
  if(q.qtype === 'fill'){
    const sentenceHtml = q.item.s.replace('___', '<span class="blank">＿＿＿</span>');
    questionHtml = `
      <div class="q-label">Điền từ thích hợp vào chỗ trống</div>
      <div class="q-sentence">${sentenceHtml}</div>
    `;
  } else {
    const isH2M = q.mode==='h2m';
    questionHtml = `
      <div class="q-label">${isH2M ? 'Từ này có nghĩa là gì?' : 'Từ nào có nghĩa dưới đây?'}</div>
      <div class="q-main ${isH2M?'':'small'}">${isH2M ? q.item.h : q.item.m}</div>
      ${isH2M && q.item.p ? `<div class="q-sub">${q.item.p}</div>` : ''}
    `;
  }

  area.innerHTML = `
    <div class="quiz-head">
      <div class="qcount">Câu ${quizIdx+1} / ${quizItems.length}</div>
      <div class="qscore">Đúng: ${quizScore}</div>
    </div>
    <div class="quiz-bar"><i style="width:${pct}%"></i></div>
    <div class="q-box">${questionHtml}</div>
    <div class="q-options" id="qOptions"></div>
  `;
  const optWrap = document.getElementById('qOptions');

  if(q.qtype === 'fill'){
    optWrap.innerHTML = q.options.map((opt,i)=>{
      return `<button class="q-opt" data-idx="${i}"><span class="hz-opt">${opt.h}</span><div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);margin-top:4px;">${opt.p||''}</div></button>`;
    }).join('');
  } else {
    const isH2M = q.mode==='h2m';
    optWrap.innerHTML = q.options.map((opt,i)=>{
      const label = isH2M ? opt.m : opt.h;
      const extra = (!isH2M && opt.p) ? `<div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);margin-top:4px;">${opt.p}</div>` : '';
      return `<button class="q-opt" data-idx="${i}"><span class="${isH2M?'':'hz-opt'}">${label}</span>${extra}</button>`;
    }).join('');
  }

  optWrap.querySelectorAll('.q-opt').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(quizAnswered) return;
      quizAnswered = true;
      const chosen = q.options[parseInt(btn.dataset.idx,10)];
      const correct = chosen.h===q.item.h && chosen.m===q.item.m;
      if(correct) quizScore++;
      else quizReview.push(q.item);
      optWrap.querySelectorAll('.q-opt').forEach((b2,i2)=>{
        b2.classList.add('disabled');
        const o2 = q.options[i2];
        const isCorrectOpt = o2.h===q.item.h && o2.m===q.item.m;
        if(isCorrectOpt) b2.classList.add('correct');
        else if(b2===btn) b2.classList.add('wrong');
        else b2.classList.add('dim');
      });
      setTimeout(()=>{ quizIdx++; renderQuizQuestion(); }, 850);
    });
  });
}

function renderQuizResult(){
  const area = document.getElementById('quizArea');
  const total = quizItems.length;
  const pct = total ? Math.round(quizScore/total*100) : 0;
  area.innerHTML = `
    <div class="quiz-result">
      <div class="score-big">${quizScore}/${total}</div>
      <div class="score-label">Bạn đã đúng ${pct}% · ${pct>=80?'Xuất sắc! 👏':pct>=50?'Khá tốt, cố lên nhé!':'Cần ôn lại thêm nha!'}</div>
      ${quizReview.length ? `<div class="review-list">${quizReview.map(it=>`<div class="review-item miss"><span>${it.h} (${it.p||''})</span><span>${it.m}</span></div>`).join('')}</div>` : ''}
      <button id="quizRetry">Làm bài mới</button>
    </div>
  `;
  document.getElementById('quizRetry').addEventListener('click', renderQuizSetup);
}

/* ---------------- init ---------------- */
loadProgress();
renderGrammar();
renderQuizSetup();
</script>
