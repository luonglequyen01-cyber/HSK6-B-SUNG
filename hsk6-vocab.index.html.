<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>词汇本 · Sổ Tay HSK6</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700;900&family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#EAE2CC;
  --paper-2:#E1D6B8;
  --paper-3:#D8CBA6;
  --ink:#221C15;
  --ink-soft:#5A5245;
  --ink-faint:#8A8271;
  --seal:#AF2530;
  --seal-dark:#7F1B22;
  --seal-glow:rgba(175,37,48,0.16);
  --jade:#4F7A68;
  --jade-dark:#3A5C4E;
  --gold:#9C6B2E;
  --gold-soft:#EFDDB8;
  --line: rgba(34,28,21,0.14);
  --line-strong: rgba(34,28,21,0.28);
  --shadow: 0 8px 24px rgba(34,28,21,0.10), 0 2px 6px rgba(34,28,21,0.08);
  --radius: 3px;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(ellipse 1200px 600px at 15% -10%, rgba(255,255,255,0.35), transparent 60%),
    var(--paper);
  background-attachment: fixed;
  color:var(--ink);
  font-family:'Be Vietnam Pro', -apple-system, sans-serif;
  min-height:100vh;
  position:relative;
}
body::before{
  content:"";
  position:fixed; inset:0;
  pointer-events:none;
  opacity:0.5;
  background-image:
    repeating-linear-gradient(0deg, rgba(34,28,21,0.015) 0px, rgba(34,28,21,0.015) 1px, transparent 1px, transparent 3px);
  z-index:0;
}
.app{position:relative; z-index:1; max-width:920px; margin:0 auto; padding:0 18px 64px;}

/* ---------- Header ---------- */
header.top{
  padding:34px 4px 18px;
  display:flex; align-items:flex-end; justify-content:space-between; gap:16px;
  flex-wrap:wrap;
  border-bottom:1px solid var(--line-strong);
  margin-bottom:22px;
}
.brand{display:flex; align-items:center; gap:14px;}
.brand-seal{
  width:52px;height:52px; flex:none;
  background:var(--seal);
  color:#F4E9D8;
  border-radius:6px;
  display:flex; align-items:center; justify-content:center;
  font-family:'Noto Serif SC', serif; font-weight:900; font-size:24px;
  box-shadow: var(--shadow);
  transform:rotate(-3deg);
  position:relative;
}
.brand-seal::after{
  content:"";position:absolute; inset:3px;
  border:1px solid rgba(244,233,216,0.55);
  border-radius:3px;
}
.brand-text h1{
  margin:0; font-family:'Noto Serif SC', serif; font-weight:700;
  font-size:26px; letter-spacing:0.5px; line-height:1.1;
}
.brand-text p{margin:4px 0 0; font-size:12.5px; color:var(--ink-soft); letter-spacing:0.3px;}
.progress-chip{
  display:flex; align-items:center; gap:10px;
  background:var(--paper-2);
  border:1px solid var(--line-strong);
  border-radius:999px;
  padding:8px 16px 8px 8px;
}
.progress-chip .ring{
  width:34px;height:34px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:conic-gradient(var(--seal) calc(var(--pct,0) * 1%), rgba(34,28,21,0.12) 0);
  flex:none;
}
.progress-chip .ring-in{
  width:26px;height:26px;border-radius:50%;background:var(--paper-2);
  display:flex;align-items:center;justify-content:center;
  font-family:'JetBrains Mono',monospace; font-size:9px; font-weight:700; color:var(--seal-dark);
}
.progress-chip .plabel{font-size:12px; color:var(--ink-soft); line-height:1.3;}
.progress-chip .plabel b{color:var(--ink); font-family:'JetBrains Mono',monospace; font-size:13px;}

/* ---------- Tabs ---------- */
nav.tabs{
  display:flex; gap:6px; margin-bottom:26px; flex-wrap:wrap;
}
nav.tabs button{
  font-family:'Be Vietnam Pro', sans-serif;
  font-size:13.5px; font-weight:600;
  color:var(--ink-soft);
  background:transparent;
  border:1px solid transparent;
  padding:9px 16px;
  border-radius:999px;
  cursor:pointer;
  display:flex; align-items:center; gap:8px;
  transition:all .18s ease;
}
nav.tabs button .zh{font-family:'Noto Serif SC', serif; font-weight:700; font-size:14px;}
nav.tabs button:hover{background:var(--paper-2); color:var(--ink);}
nav.tabs button.active{
  background:var(--ink); color:var(--paper);
  border-color:var(--ink);
}
nav.tabs button.active .zh{color:var(--paper);}

.panel{display:none; animation:fadein .3s ease;}
.panel.active{display:block;}
@keyframes fadein{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

/* ---------- Study list ---------- */
.toolbar{display:flex; gap:10px; margin-bottom:18px; flex-wrap:wrap; align-items:center;}
.search-wrap{position:relative; flex:1; min-width:200px;}
.search-wrap input{
  width:100%; padding:11px 14px 11px 38px;
  border:1px solid var(--line-strong); border-radius:var(--radius);
  background:#F4EEDC; font-family:'Be Vietnam Pro',sans-serif; font-size:14px; color:var(--ink);
  outline:none;
}
.search-wrap input:focus{border-color:var(--seal);}
.search-wrap svg{position:absolute; left:12px; top:50%; transform:translateY(-50%); width:15px;height:15px; opacity:0.5;}
.filter-group{display:flex; gap:6px;}
.filter-group button{
  font-size:12.5px; font-weight:600; padding:9px 13px; border-radius:var(--radius);
  border:1px solid var(--line-strong); background:#F4EEDC; color:var(--ink-soft); cursor:pointer;
}
.filter-group button.active{background:var(--jade); border-color:var(--jade); color:#F4EEDC;}

.word-list{display:flex; flex-direction:column; gap:8px;}
.word-row{
  background:#F4EEDC;
  border:1px solid var(--line);
  border-left:3px solid transparent;
  border-radius:var(--radius);
  padding:13px 16px;
  display:flex; align-items:center; gap:16px;
  cursor:pointer;
  transition:border-color .15s ease, transform .1s ease;
}
.word-row:hover{border-left-color:var(--gold); transform:translateX(2px);}
.word-row.mastered{border-left-color:var(--jade);}
.word-row .hz{
  font-family:'Noto Serif SC', serif; font-weight:700; font-size:22px; min-width:110px;
}
.word-row .py{font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--gold); min-width:100px;}
.word-row .mn{font-size:14px; color:var(--ink-soft); flex:1; line-height:1.4;}
.word-row .cat-tag{font-size:10px; font-family:'JetBrains Mono',monospace; color:var(--ink-faint); border:1px solid var(--line-strong); padding:2px 6px; border-radius:3px; flex:none;}
.word-row .mstar{flex:none; width:20px; height:20px; opacity:0.35;}
.word-row.mastered .mstar{opacity:1;}
.empty-note{padding:40px 10px; text-align:center; color:var(--ink-faint); font-size:14px;}

/* ---------- Flashcards ---------- */
.fc-controls{display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;}
.fc-deck-select{display:flex; gap:6px;}
.fc-deck-select button{font-size:12.5px; font-weight:600; padding:8px 13px; border-radius:var(--radius); border:1px solid var(--line-strong); background:#F4EEDC; color:var(--ink-soft); cursor:pointer;}
.fc-deck-select button.active{background:var(--ink); border-color:var(--ink); color:var(--paper);}
.fc-count{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-soft);}

.fc-stage{display:flex; flex-direction:column; align-items:center; gap:22px;}
.fc-progress-bar{width:100%; max-width:460px; height:4px; background:var(--line-strong); border-radius:2px; overflow:hidden;}
.fc-progress-bar i{display:block; height:100%; background:var(--seal); width:0%; transition:width .3s ease;}

.card-scene{width:100%; max-width:460px; height:280px; perspective:1400px; position:relative;}
.flashcard{
  width:100%; height:100%; position:relative;
  transform-style:preserve-3d;
  transition:transform .5s cubic-bezier(.2,.8,.2,1);
  cursor:pointer;
}
.flashcard.flipped{transform:rotateY(180deg);}
.face{
  position:absolute; inset:0; backface-visibility:hidden;
  border-radius:8px; border:1px solid var(--line-strong);
  background:#F4EEDC;
  box-shadow: var(--shadow);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; padding:24px;
}
.face.front .hz{font-family:'Noto Serif SC', serif; font-weight:700; font-size:56px; line-height:1;}
.face.front .py{margin-top:14px; font-family:'JetBrains Mono',monospace; color:var(--gold); font-size:15px; letter-spacing:0.5px;}
.face.front .hint{position:absolute; bottom:16px; font-size:11px; color:var(--ink-faint); letter-spacing:0.5px;}
.face.back{transform:rotateY(180deg); background:var(--ink); color:var(--paper);}
.face.back .py2{font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--gold-soft); margin-bottom:10px;}
.face.back .mn{font-size:19px; font-weight:600; line-height:1.4; max-width:340px;}
.face.back .hz-small{font-family:'Noto Serif SC',serif; font-size:15px; opacity:0.6; margin-top:14px;}

.seal-stamp{
  position:absolute; top:14px; right:14px; width:58px; height:58px;
  opacity:0; transform:scale(2) rotate(-18deg);
  pointer-events:none;
}
.seal-stamp.show{animation:stampdown .5s cubic-bezier(.2,.9,.3,1.1) forwards;}
@keyframes stampdown{
  0%{opacity:0; transform:scale(2.4) rotate(-18deg);}
  55%{opacity:1; transform:scale(0.92) rotate(-8deg);}
  75%{transform:scale(1.06) rotate(-8deg);}
  100%{opacity:1; transform:scale(1) rotate(-8deg);}
}

.fc-actions{display:flex; gap:12px; width:100%; max-width:460px;}
.fc-actions button{
  flex:1; padding:13px; border-radius:var(--radius); border:1px solid var(--line-strong);
  font-family:'Be Vietnam Pro', sans-serif; font-weight:700; font-size:14px; cursor:pointer;
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.btn-forget{background:#F4EEDC; color:var(--ink-soft);}
.btn-forget:hover{border-color:var(--ink-soft);}
.btn-know{background:var(--jade); color:#F4EEDC; border-color:var(--jade);}
.btn-know:hover{background:var(--jade-dark);}
.fc-done{text-align:center; padding:50px 10px;}
.fc-done .zh-big{font-family:'Noto Serif SC',serif; font-size:38px; font-weight:700; margin-bottom:8px;}
.fc-done p{color:var(--ink-soft); margin:6px 0 22px;}
.fc-done button{background:var(--seal); color:#F4E9D8; border:none; padding:12px 24px; border-radius:var(--radius); font-weight:700; cursor:pointer; font-size:14px;}

/* ---------- Grammar ---------- */
.grammar-list{display:flex; flex-direction:column; gap:14px;}
.g-card{background:#F4EEDC; border:1px solid var(--line); border-radius:6px; padding:20px 22px;}
.g-card .pattern{font-family:'Noto Serif SC',serif; font-weight:700; font-size:21px; color:var(--seal-dark); margin-bottom:2px;}
.g-card .py{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--gold); margin-bottom:10px;}
.g-card .meaning{font-weight:600; margin-bottom:10px; font-size:14.5px;}
.g-card .usage{font-size:13.5px; color:var(--ink-soft); line-height:1.6; border-top:1px dashed var(--line-strong); padding-top:10px;}

/* ---------- Quiz ---------- */
.quiz-setup{background:#F4EEDC; border:1px solid var(--line); border-radius:6px; padding:32px 28px; text-align:center;}
.quiz-setup h2{font-family:'Noto Serif SC',serif; margin:0 0 6px; font-size:22px;}
.quiz-setup p{color:var(--ink-soft); font-size:13.5px; margin:0 0 22px;}
.quiz-len{display:flex; gap:10px; justify-content:center; margin-bottom:22px; flex-wrap:wrap;}
.quiz-len button{padding:10px 20px; border-radius:999px; border:1px solid var(--line-strong); background:var(--paper); font-weight:700; cursor:pointer; font-family:'JetBrains Mono',monospace; font-size:13px;}
.quiz-len button.active{background:var(--ink); color:var(--paper); border-color:var(--ink);}
.quiz-mode{display:flex; gap:10px; justify-content:center; margin-bottom:26px; flex-wrap:wrap;}
.quiz-mode button{padding:9px 16px; border-radius:999px; border:1px solid var(--line-strong); background:var(--paper); font-weight:600; cursor:pointer; font-family:'Be Vietnam Pro',sans-serif; font-size:12.5px; color:var(--ink-soft);}
.quiz-mode button.active{background:var(--gold); color:#F4EEDC; border-color:var(--gold);}
.q-box .q-sentence{font-family:'Noto Serif SC',serif; font-weight:600; font-size:22px; line-height:1.7;}
.q-box .q-sentence .blank{display:inline-block; min-width:52px; border-bottom:2px solid var(--seal); color:var(--seal); font-weight:900;}
.quiz-start-btn{background:var(--seal); color:#F4E9D8; border:none; padding:13px 30px; border-radius:var(--radius); font-weight:700; font-size:14.5px; cursor:pointer;}

.quiz-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;}
.quiz-head .qcount{font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--ink-soft);}
.quiz-head .qscore{font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--jade-dark); font-weight:700;}
.quiz-bar{height:4px; background:var(--line-strong); border-radius:2px; overflow:hidden; margin-bottom:26px;}
.quiz-bar i{display:block; height:100%; background:var(--gold); transition:width .3s;}

.q-box{background:#F4EEDC; border:1px solid var(--line); border-radius:6px; padding:32px 28px; text-align:center; margin-bottom:18px;}
.q-box .q-label{font-size:11px; text-transform:uppercase; letter-spacing:1.5px; color:var(--ink-faint); margin-bottom:14px;}
.q-box .q-main{font-family:'Noto Serif SC',serif; font-weight:700; font-size:38px; line-height:1.2;}
.q-box .q-main.small{font-family:'Be Vietnam Pro',sans-serif; font-size:19px; font-weight:600;}
.q-box .q-sub{margin-top:8px; font-family:'JetBrains Mono',monospace; color:var(--gold); font-size:13px;}

.q-options{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
@media (max-width:520px){.q-options{grid-template-columns:1fr;}}
.q-opt{
  text-align:left; padding:14px 16px; border-radius:6px; border:1px solid var(--line-strong);
  background:#F4EEDC; cursor:pointer; font-size:14px; color:var(--ink); font-family:'Be Vietnam Pro',sans-serif;
  transition:all .12s ease;
}
.q-opt .hz-opt{font-family:'Noto Serif SC',serif; font-weight:700; font-size:19px;}
.q-opt:hover{border-color:var(--gold);}
.q-opt.correct{background:var(--jade); border-color:var(--jade); color:#F4EEDC;}
.q-opt.wrong{background:var(--seal); border-color:var(--seal); color:#F4EEDC;}
.q-opt.disabled{pointer-events:none;}
.q-opt.dim{opacity:0.45;}

.quiz-result{background:#F4EEDC; border:1px solid var(--line); border-radius:6px; padding:40px 28px; text-align:center;}
.quiz-result .score-big{font-family:'Noto Serif SC',serif; font-weight:900; font-size:56px; color:var(--seal); line-height:1;}
.quiz-result .score-label{color:var(--ink-soft); margin:8px 0 26px; font-size:14px;}
.quiz-result .review-list{text-align:left; max-width:420px; margin:0 auto 26px; display:flex; flex-direction:column; gap:6px; max-height:220px; overflow:auto; padding-right:4px;}
.quiz-result .review-item{font-size:13px; padding:8px 12px; border-radius:4px; background:var(--paper-2); display:flex; justify-content:space-between; gap:10px;}
.quiz-result .review-item.miss{background:var(--seal-glow);}
.quiz-result button{background:var(--seal); color:#F4E9D8; border:none; padding:12px 26px; border-radius:var(--radius); font-weight:700; cursor:pointer; font-size:14px;}

footer.credit{text-align:center; margin-top:50px; font-size:11.5px; color:var(--ink-faint); letter-spacing:0.4px;}

/* Detail modal */
.modal-bg{position:fixed; inset:0; background:rgba(34,28,21,0.55); display:none; align-items:center; justify-content:center; z-index:50; padding:20px;}
.modal-bg.show{display:flex;}
.modal-card{background:var(--paper); border-radius:8px; max-width:380px; width:100%; padding:28px; box-shadow:var(--shadow); position:relative; text-align:center;}
.modal-card .hz{font-family:'Noto Serif SC',serif; font-weight:900; font-size:44px;}
.modal-card .py{font-family:'JetBrains Mono',monospace; color:var(--gold); margin-top:8px; font-size:14px;}
.modal-card .mn{margin-top:14px; font-size:16px; font-weight:600;}
.modal-card .mtoggle{margin-top:22px; border:none; background:var(--jade); color:#F4EEDC; padding:10px 20px; border-radius:999px; font-weight:700; cursor:pointer; font-size:13px;}
.modal-card .mtoggle.on{background:var(--ink);}
.modal-close{position:absolute; top:12px; right:14px; background:none; border:none; font-size:18px; color:var(--ink-soft); cursor:pointer;}
</style>
</head>
<body>
<div class="app">

  <header class="top">
    <div class="brand">
      <div class="brand-seal">词</div>
      <div class="brand-text">
        <h1>词汇本 <span style="font-weight:400;font-size:15px;color:var(--ink-soft);">Sổ Tay HSK6</span></h1>
        <p>Từ vựng &amp; ngữ pháp · TC2-1 — <span id="totalHeaderCount">495</span> mục</p>
      </div>
    </div>
    <div class="progress-chip">
      <div class="ring" id="progressRing"><div class="ring-in" id="progressPct">0%</div></div>
      <div class="plabel">Đã thuộc<br><b id="masteredCount">0</b> / <span id="totalCount">304</span></div>
    </div>
  </header>

  <nav class="tabs">
    <button class="tab-btn active" data-tab="study"><span class="zh">学</span>Học từ</button>
    <button class="tab-btn" data-tab="flash"><span class="zh">闪</span>Flashcard</button>
    <button class="tab-btn" data-tab="grammar"><span class="zh">语</span>Ngữ pháp</button>
    <button class="tab-btn" data-tab="quiz"><span class="zh">练</span>Bài tập</button>
  </nav>

  <!-- STUDY PANEL -->
  <section class="panel active" id="panel-study">
    <div class="toolbar">
      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="Tìm theo chữ Hán, pinyin hoặc nghĩa tiếng Việt...">
      </div>
      <div class="filter-group" id="catFilter">
        <button class="active" data-cat="all">Tất cả</button>
        <button data-cat="TC2-1">Phần 1</button>
        <button data-cat="TC2-1b">Phần 2</button>
        <button data-cat="TC2-1c">Phần 3</button>
        <button data-cat="TC2-1d">Phần 4</button>
        <button data-cat="TC2-1e">Phần 5</button>
        <button data-cat="mastered">Đã thuộc</button>
      </div>
    </div>
    <div class="word-list" id="wordList"></div>
  </section>

  <!-- FLASHCARD PANEL -->
  <section class="panel" id="panel-flash">
    <div class="fc-controls">
      <div class="fc-deck-select" id="fcDeckSelect">
        <button class="active" data-deck="all">Tất cả</button>
        <button data-deck="unmastered">Chưa thuộc</button>
        <button data-deck="TC2-1">Phần 1</button>
        <button data-deck="TC2-1b">Phần 2</button>
        <button data-deck="TC2-1c">Phần 3</button>
        <button data-deck="TC2-1d">Phần 4</button>
        <button data-deck="TC2-1e">Phần 5</button>
      </div>
      <div class="fc-count" id="fcCount"></div>
    </div>
    <div class="fc-stage">
      <div class="fc-progress-bar"><i id="fcBar"></i></div>
      <div id="fcCardArea"></div>
    </div>
  </section>

  <!-- GRAMMAR PANEL -->
  <section class="panel" id="panel-grammar">
    <div class="grammar-list" id="grammarList"></div>
  </section>

  <!-- QUIZ PANEL -->
  <section class="panel" id="panel-quiz">
    <div id="quizArea"></div>
  </section>

  <footer class="credit">拓 学 而 时 习 之 · Ôn tập đều đặn mỗi ngày để thuộc lâu hơn</footer>
</div>

<div class="modal-bg" id="modalBg">
  <div class="modal-card" id="modalCard">
    <button class="modal-close" id="modalClose">✕</button>
    <div class="hz" id="modalHz"></div>
    <div class="py" id="modalPy"></div>
    <div class="mn" id="modalMn"></div>
    <button class="mtoggle" id="modalToggle">Đánh dấu đã thuộc</button>
  </div>
